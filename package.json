{
  "name": "heart-of-the-beast",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @heart-of-the-beast/frontend",
    "dev:up": "node scripts/dev.mjs up",
    "dev:down": "node scripts/dev.mjs down",
    "dev:status": "node scripts/dev.mjs status",
    "db:migrate": "node scripts/dev.mjs migrate",
    "db:reset": "node scripts/dev.mjs reset",
    "build": "npm run art:build && npm run build --workspace @heart-of-the-beast/frontend",
    "preview": "npm run preview --workspace @heart-of-the-beast/frontend",
    "art:build": "node scripts/pixel-art/build.mjs && node scripts/pixel-art/build-interface.mjs",
    "art:verify": "npm run art:build && node scripts/pixel-art/verify.mjs",
    "art:gallery": "node scripts/pixel-art/gallery.mjs && node scripts/pixel-art/build-interface.mjs --gallery",
    "art:rooms": "node scripts/pixel-art/rooms/build.mjs",
    "art:rooms:verify": "node scripts/pixel-art/rooms/verify.mjs",
    "art:rooms:gallery": "node scripts/pixel-art/rooms/gallery.mjs",
    "test:audio": "npm run test:audio --workspace @heart-of-the-beast/frontend",
    "test:ui": "npm run test:ui --workspace @heart-of-the-beast/frontend",
    "audio:check": "node scripts/audio/offline-render.mjs"
  }
}
